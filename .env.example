# Copy this file to .env and fill in real values. Never commit .env.
ENVIRONMENT=dev
GEMINI_API_KEY=
SLACK_WEBHOOK_URL=
DEMO_API_KEY=
MAX_UPLOAD_BYTES=5242880
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW=60
DEFAULT_MODEL=gemini-3.5-flash-lite
ESCALATION_MODEL=gemini-3.5-flash
DATABASE_URL=sqlite:///./invoiceguard.db
UPLOAD_DIR=data/uploads
VENDORS_PATH=data/vendors.json
ANOMALY_MODEL_PATH=models/anomaly.joblib
APPROVE_MIN_CONFIDENCE=0.85
REJECT_BELOW_CONFIDENCE=0.40
# SAP_BASE_URL=   # unset -> own mock at http://127.0.0.1:$PORT/mock-sap
SAP_COMPANY_CODE=1000
SAP_GL_ACCOUNT=400000
SAP_TAX_CODE=V1
SAP_MAX_ATTEMPTS=3
SAP_RETRY_DELAY=0.5
OCR_MAX_SIDE_LEN=1280
